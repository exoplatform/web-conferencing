* but WITHOUT ANY WARRANTY; without even the implied warranty of
* MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
* GNU Affero General Public License for more details.
*
* You should have received a copy of the GNU Affero General Public License
* along with this program. If not, see <http://www.gnu.org/licenses/>.
*
*/
  boolean groupCall = "true".equals(IS_GROUP);
  String message = groupCall ? _ctx.appRes("Notification.message.MissedCallPlugin.group", "<span style=\"color:${io.meeds.portal.mail.EmailLayout.linkColor()};text-decoration:none;font-weight:bold;font-family:${io.meeds.portal.mail.EmailLayout.fontStack()};\">" + CALLER_NAME + "</span>", "<span style=\"color:${io.meeds.portal.mail.EmailLayout.linkColor()};text-decoration:none;font-weight:bold;font-family:${io.meeds.portal.mail.EmailLayout.fontStack()};\">" + CALL_OWNER + "</span>")
                             : _ctx.appRes("Notification.message.MissedCallPlugin.user", "<span style=\"color:${io.meeds.portal.mail.EmailLayout.linkColor()};text-decoration:none;font-weight:bold;font-family:${io.meeds.portal.mail.EmailLayout.fontStack()};\">" + CALLER_NAME + "</span>");
  boolean endedCall = groupCall && "true".equals(IS_ENDED);
  // An ended call only leads to its space, when it has one
  boolean showAction = !endedCall || "true".equals(HAS_CALL_PAGE);
  String actionLabel = endedCall ? _ctx.appRes("Notification.label.MissedCallPlugin.openSpace")
                                 : groupCall ? _ctx.appRes("Notification.label.MissedCallPlugin.join") : _ctx.appRes("Notification.label.MissedCallPlugin.callAgain");
%>
<table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="width:100%;overflow-wrap:anywhere;word-break:break-word;background-color: #ffffff; font-size: 15px;color: #1d2327;line-height: 1.7;font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="${io.meeds.portal.mail.EmailLayout.dir(_ctx.language)}">
    <%
          _templateContext.put("header_title", _ctx.appRes("Notification.title.MissedCallPlugin"));
          _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td style="padding:0 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="max-width:600px;margin:0 auto;background-color: #ffffff;">
                <tr>
                    <td bgcolor="#ffffff" style="background-color: #ffffff;">
                        <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="background-color: #ffffff; color: #1d2327;line-height: 1.7;">
                            <tr>
                                <td align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" bgcolor="#ffffff" style="background-color: #ffffff;padding: 30px 0 10px 0;">
                                    <p style="margin: 0 0 14px; font-size: 15px; color: #1d2327; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto"><%=_ctx.appRes("Notification.label.SayHello")%> <%=_ctx.escapeHTML(FIRSTNAME)%>,</p>
                                    <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="background-color: #ffffff; font-size: 15px;color: #1d2327;line-height: 1.7;">
                                        <tbody>
                                        <tr>
                                            <!--[if mso]>
                                            <td width="64" align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" valign="top" bgcolor="#ffffff" style="vertical-align: top; ">
                                                <img width="44" height="44" style="border-radius: 50%;" src="$CALLER_AVATAR" alt="$CALLER_NAME" title="$CALLER_NAME" />
                                            </td>
                                            <![endif]-->
                                            <td width="64" align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" valign="top" bgcolor="#ffffff" style="mso-hide:all; vertical-align: top; ">
                                                <img width="44" height="44" style="border-radius: 50%;" src="$CALLER_AVATAR" alt="$CALLER_NAME" title="$CALLER_NAME" />
                                            </td>
                                            <td align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" valign="top" style="padding: 0;">
                                                <p style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto"><%=message%></p>
                                                <% if (endedCall) { %>
                                                <p style="margin:0; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto"><%=_ctx.appRes("Notification.message.MissedCallPlugin.ended")%></p>
                                                <% } %>
                                                <% if (showAction) { %>
                                                <div dir="${io.meeds.portal.mail.EmailLayout.dir(_ctx.language)}" style="margin: ${io.meeds.portal.mail.EmailLayout.buttonRowMargin(_ctx.language, '64px')};">
                                                    <%=io.meeds.portal.mail.EmailLayout.actionLink(actionLabel, "$CALL_LINK", true)%>
                                                </div>
                                                <% } %>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                <p style="margin:28px 0 0 0; color: #5d676d;font-size: 13px;font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()}">
                                        <%=io.meeds.portal.mail.EmailLayout.linkStyled(_ctx.appRes("Notification.label.footer", FOOTER_LINK))%>
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>
