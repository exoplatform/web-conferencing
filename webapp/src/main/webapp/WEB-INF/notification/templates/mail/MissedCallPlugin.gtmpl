  boolean groupCall = "true".equals(IS_GROUP);
  String message = groupCall ? _ctx.appRes("Notification.message.MissedCallPlugin.group", "<strong>" + CALLER_NAME + "</strong>", "<strong>" + CALL_OWNER + "</strong>")
                             : _ctx.appRes("Notification.message.MissedCallPlugin.user", "<strong>" + CALLER_NAME + "</strong>");
  String actionLabel = groupCall ? _ctx.appRes("Notification.label.MissedCallPlugin.join") : _ctx.appRes("Notification.label.MissedCallPlugin.callAgain");
%>
<table border="0" cellpadding="0" cellspacing="0" width="600" bgcolor="#ffffff" align="center" style="background-color: #ffffff; font-size: 13px;color:#333333;line-height: 18px;font-family: HelveticaNeue, Helvetica, Arial, sans-serif;">
    <%
          _templateContext.put("header_title", _ctx.appRes("Notification.title.MissedCallPlugin"));
          _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td bgcolor="#ffffff" style="background-color: #ffffff;">
            <table cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="background-color: #ffffff; border-left:1px solid #d8d8d8;border-right:1px solid #d8d8d8;">
                <tr>
                    <td bgcolor="#ffffff" style="background-color: #ffffff;">
                        <table border="0" cellpadding="0" cellspacing="0" width="92%" bgcolor="#ffffff" align="center" style="background-color: #ffffff; font-size: 13px;color:#333333;line-height: 18px;">
                            <tr>
                                <td align="left" bgcolor="#ffffff" style="background-color: #ffffff;padding: 20px 0 10px;">
                                    <p style="margin: 0 0 10px; color: #333333; font-size: 13px; line-height: 18px;">
                                        <%=_ctx.appRes("Notification.label.SayHello")%> $USER
                                    </p>
                                    <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="background-color: #ffffff; font-size: 13px;color:#333333;line-height: 18px;">
                                        <tbody>
                                        <tr>
                                            <td align="left" valign="top" bgcolor="#ffffff" style="vertical-align: top; padding: 0 15px 0 0;">
                                                <img style="border-radius: 4px;" height="76" width="76" src="$CALLER_AVATAR" alt="$CALLER_NAME" title="$CALLER_NAME" />
                                            </td>
                                            <td align="left" valign="top" style="padding: 0;">
                                                <p style="margin: 0 0 10px; color: #333333; font-size: 13px; line-height: 18px;"><%=message%></p>
                                                <p style="margin: 0">
                                                    <a target="_blank" href="$CALL_LINK" style="display: inline-block; font-size: 11px; color: #333333; background-color: #f1f1f1; border: 1px solid #bbbbbb; border-radius: 4px; padding: 5px 8px; text-decoration: none;"><%=actionLabel%></a>
                                                </p>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>
