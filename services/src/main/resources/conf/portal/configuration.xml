<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd http://www.exoplatform.org/xml/ns/kernel_1_2.xsd"
               xmlns="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd">


    <component>
        <type>org.exoplatform.webconferencing.notification.pwa.CallRecordingPwaPlugin</type>
    </component>
    <component>
        <type>org.exoplatform.webconferencing.notification.pwa.MissedCallPwaPlugin</type>
    </component>
    <component>
        <type>org.exoplatform.webconferencing.notification.pwa.DeclinedCallPwaPlugin</type>
    </component>
    <external-component-plugins>
        <target-component>org.exoplatform.services.listener.ListenerService</target-component>
        <component-plugin>
            <name>exo.webconferencing.callRecorded</name>
            <set-method>addListener</set-method>
            <type>org.exoplatform.webconferencing.listeners.CallRecordingNotificationListener</type>
        </component-plugin>
        <component-plugin>
            <name>exo.webconferencing.callMissed</name>
            <set-method>addListener</set-method>
            <type>org.exoplatform.webconferencing.listeners.CallMissedNotificationListener</type>
        </component-plugin>
        <component-plugin>
            <name>exo.webconferencing.callDeclined</name>
            <set-method>addListener</set-method>
            <type>org.exoplatform.webconferencing.listeners.CallDeclinedNotificationListener</type>
        </component-plugin>
        <component-plugin>
            <name>exo.webconferencing.callDeclinesClosed</name>
            <set-method>addListener</set-method>
            <type>org.exoplatform.webconferencing.listeners.CallDeclinedNotificationListener</type>
        </component-plugin>
    </external-component-plugins>
</configuration>
